# Port for the Node proxy / production server
PORT=8787
# Set to 1 to let the proxy reach private / LAN addresses (e.g. a home Jellyfin server).
# Leave at 0 on any internet-facing deployment to prevent SSRF.
ALLOW_PRIVATE_NETWORKS=0
# Max bytes the proxy will buffer when rewriting a manifest or sniffing a page
MAX_TEXT_BYTES=8388608
# Upstream request timeout in milliseconds
UPSTREAM_TIMEOUT_MS=20000
# Password-protect the whole app (HTTP Basic Auth, any username). Strongly
# recommended for public deployments so the proxy is not an open relay.
APP_PASSWORD=
